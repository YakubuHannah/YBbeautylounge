generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                    String   @id @default(cuid())
  phone_normalised      String   @unique
  phone_raw             String
  name                  String?
  email                 String?
  marketing_consent     Boolean  @default(false)
  consent_recorded_at   DateTime?
  store_credit_balance  Int      @default(0)
  order_count           Int      @default(0)
  lifetime_value        Int      @default(0)
  first_order_at        DateTime?
  last_order_at         DateTime?
  tags                  String[] @default([])
  notes                 String?  @db.Text
  is_wholesale          Boolean  @default(false)
  wholesale_tier_id     Int?     @map("wholesale_tier_id")
  password_hash         String?

  orders              Order[]
  reviews               Review[]
  restoration_jobs    RestorationJob[]
  referral_codes        ReferralCode[]
  referral_redemptions  ReferralRedemption[]
  store_credit_txns     StoreCreditTransaction[]
  consent_records       ConsentRecord[]
  discount_redemptions  DiscountRedemption[]
  search_queries        SearchQueryLog[]
  abandoned_checkouts   AbandonedCheckout[]
  waitlist_signups      WaitlistSignup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@map("customers")
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?  @db.Text
  texture             String
  hair_origin         String?
  care_instructions   String?  @db.Text
  status              String   @default("draft")
  featured            Boolean  @default(false)
  track_inventory     Boolean  @default(true)
  before_image_id     String?  @map("before_image_id")
  after_image_id      String?  @map("after_image_id")
  seo_title           String?
  seo_description     String?  @map("seo_description")
  seo_image_id        String?  @map("seo_image_id")
  avg_rating          Float    @default(0)
  review_count        Int      @default(0)
  published_at        DateTime?
  deleted_at          DateTime?

  variants            ProductVariant[]
  images              ProductImage[]
  tags                ProductTag[]
  collections         CollectionProduct[]
  reviews             Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(cuid())
  product_id          String   @map("product_id")
  sku                 String   @unique
  length_inches       Int?
  colorway            String?
  density_percent     Int?
  draw_type           String?
  lace_type           String?
  lace_size           String?
  cap_size            String?
  hair_grade          String?
  is_pre_plucked      Boolean  @default(false)
  can_be_coloured     Boolean   @default(true)
  price               Int
  compare_at_price    Int?
  cost_price          Int?
  stock_quantity      Int      @default(0)
  low_stock_threshold Int      @default(2)
  weight_grams        Int?
  is_active           Boolean  @default(true)

  product             Product  @relation(fields: [product_id], references: [id])
  images              ProductImage[]
  order_items         OrderItem[]
  stock_reservations  StockReservation[]
  stock_adjustments   StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(cuid())
  product_id  String   @map("product_id")
  variant_id  String?  @map("variant_id")
  media_asset_id String @map("media_asset_id")
  sort_order  Int      @default(0)

  product     Product   @relation(fields: [product_id], references: [id])
  variant     ProductVariant? @relation(fields: [variant_id], references: [id])
  media_asset MediaAsset @relation(fields: [media_asset_id], references: [id])

  @@map("product_images")
}

model ProductTag {
  id        String @id @default(cuid())
  product_id String @map("product_id")
  tag       String

  product Product @relation(fields: [product_id], references: [id])

  @@map("product_tags")
}

model Collection {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String? @db.Text
  hero_image_id String? @map("hero_image_id")
  sort_order  Int @default(0)
  is_active   Boolean @default(true)
  seo_title   String?
  seo_description String? @map("seo_description")
  seo_image_id String? @map("seo_image_id")
  published_at DateTime?

  products   CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

model CollectionProduct {
  collection_id String @map("collection_id")
  product_id    String @map("product_id")
  sort_order    Int @default(0)

  collection Collection @relation(fields: [collection_id], references: [id])
  product    Product    @relation(fields: [product_id], references: [id])

  @@id([collection_id, product_id])
  @@map("collection_products")
}

model Order {
  id                  String   @id @default(cuid())
  order_number        String   @unique
  customer_id         String?  @map("customer_id")
  customer_name_snapshot String
  customer_phone_snapshot String
  customer_email_snapshot String?
  delivery_address      String
  city                  String
  state                 String
  country               String
  delivery_method       String    @default("delivery")
  order_type            String    @default("product")
  order_channel         String    @default("self_serve")
  subtotal              Int
  delivery_fee          Int       @default(0)
  discount_amount       Int       @default(0)
  vat_amount            Int       @default(0)
  total                 Int
  amount_paid           Int       @default(0)
  discount_code_id      String?   @map("discount_code_id")
  referral_code_id      String?   @map("referral_code_id")
  payment_status        String    @default("pending")
  fulfillment_status    String    @default("unfulfilled")
  payment_plan          String    @default("full")
  balance_due_amount    Int?
  balance_due_at        DateTime?
  courier_name          String?
  tracking_number       String?
  internal_notes        String?   @db.Text
  paystack_reference    String?   @unique

  customer            Customer?    @relation(fields: [customer_id], references: [id])
  items               OrderItem[]
  events              OrderEvent[]
  payments            Payment[]
  discount_redemptions DiscountRedemption[]
  stock_reservations  StockReservation[]
  reviews             Review[]
  referral_redemptions ReferralRedemption[]
  store_credit_txns   StoreCreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(cuid())
  order_id               String   @map("order_id")
  product_variant_id     String?  @map("product_variant_id")
  product_name_snapshot  String
  variant_description_snapshot String
  quantity               Int
  unit_price             Int
  unit_cost              Int?
  line_total             Int

  order       Order       @relation(fields: [order_id], references: [id])
  variant     ProductVariant? @relation(fields: [product_variant_id], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id          String   @id @default(cuid())
  order_id    String   @map("order_id")
  event_type  String
  from_value  String?
  to_value    String?
  description String?  @db.Text
  actor_type  String   @default("system")
  actor_id    String?
  is_customer_visible Boolean @default(false)
  created_at  DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id])

  @@map("order_events")
}

model Payment {
  id                      String   @id @default(cuid())
  order_id                String   @map("order_id")
  amount                  Int
  type                    String
  method                  String
  paystack_reference      String?  @map("paystack_reference")
  paystack_channel        String?  @map("paystack_channel")
  status                  String   @default("pending")
  verified_at             DateTime?
  recorded_by_admin_id    String?  @map("recorded_by_admin_id")
  raw_webhook_payload     Json?

  order Order @relation(fields: [order_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model StockReservation {
  id        String   @id @default(cuid())
  product_variant_id String @map("product_variant_id")
  quantity  Int
  order_id  String   @map("order_id")
  expires_at DateTime
  released_at DateTime?

  variant ProductVariant @relation(fields: [product_variant_id], references: [id])
  order   Order @relation(fields: [order_id], references: [id])

  @@map("stock_reservations")
}

model StockAdjustment {
  id        String   @id @default(cuid())
  product_variant_id String @map("product_variant_id")
  quantity_delta Int
  reason    String
  note      String?  @db.Text
  actor_id  String?

  variant ProductVariant @relation(fields: [product_variant_id], references: [id])

  createdAt DateTime @default(now())

  @@map("stock_adjustments")
}

model DiscountCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  type                String
  value               Int
  minimum_order_value Int
  usage_limit_total   Int?
  usage_limit_per_customer Int?
  times_used          Int      @default(0)
  valid_from          DateTime?
  valid_until         DateTime?
  first_order_only    Boolean  @default(false)
  allows_stacking     Boolean  @default(true)
  applicable_scope    String   @default("all")
  is_active           Boolean  @default(true)

  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discount_codes")
}

model DiscountRedemption {
  id          String   @id @default(cuid())
  discount_code_id String @map("discount_code_id")
  order_id    String   @map("order_id")
  customer_id String?  @map("customer_id")

  discount_code DiscountCode @relation(fields: [discount_code_id], references: [id])
  order         Order        @relation(fields: [order_id], references: [id])
  customer      Customer?    @relation(fields: [customer_id], references: [id])

  @@map("discount_redemptions")
}

model Review {
  id          String   @id @default(cuid())
  product_id  String   @map("product_id")
  order_id    String?  @map("order_id")
  customer_id String?  @map("customer_id")
  rating      Int
  title       String?
  body        String?  @db.Text
  display_name String
  status      String   @default("pending")
  rejection_reason String?
  admin_reply   String?  @db.Text
  is_featured Boolean  @default(false)
  invite_token String? @unique @map("invite_token")

  product     Product @relation(fields: [product_id], references: [id])
  order       Order?  @relation(fields: [order_id], references: [id])
  customer    Customer? @relation(fields: [customer_id], references: [id])
  images      ReviewImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model ReviewImage {
  id          String   @id @default(cuid())
  review_id   String   @map("review_id")
  media_asset_id String @map("media_asset_id")

  review      Review @relation(fields: [review_id], references: [id])
  media_asset MediaAsset @relation(fields: [media_asset_id], references: [id])

  @@map("review_images")
}

model ReferralCode {
  id                   String   @id @default(cuid())
  customer_id          String?  @map("customer_id")
  code                 String   @unique
  times_used           Int      @default(0)
  total_reward_earned  Int      @default(0)
  is_active            Boolean  @default(true)

  customer           Customer? @relation(fields: [customer_id], references: [id])
  redemptions        ReferralRedemption[]

  @@map("referral_codes")
}

model ReferralRedemption {
  id                   String   @id @default(cuid())
  referral_code_id     String   @map("referral_code_id")
  order_id             String   @map("order_id")
  referred_customer_id String?  @map("referred_customer_id")
  referee_discount_amount Int
  referrer_reward_amount  Int
  status               String   @default("pending")
  released_at          DateTime?

  referral_code ReferralCode @relation(fields: [referral_code_id], references: [id])
  order         Order @relation(fields: [order_id], references: [id])
  referred_customer Customer? @relation(fields: [referred_customer_id], references: [id])

  @@map("referral_redemptions")
}

model StoreCreditTransaction {
  id          String   @id @default(cuid())
  customer_id String   @map("customer_id")
  amount      Int
  type        String
  order_id    String?  @map("order_id")
  balance_after Int
  note        String?  @db.Text
  actor_id    String?
  created_at  DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
  order    Order?    @relation(fields: [order_id], references: [id])

  @@map("store_credit_transactions")
}

model RestorationJob {
  id                       String   @id @default(cuid())
  job_number               String   @unique
  customer_id              String?  @map("customer_id")
  wig_type                 String
  current_condition        String?
  customer_request         String?  @db.Text
  is_lagos                 Boolean  @default(true)
  status                   String   @default("enquiry")
  service_tier_id          String?  @map("service_tier_id")
  quoted_amount            Int?
  quoted_turnaround_days   Int?
  quote_sent_at            DateTime?
  quote_accepted_at        DateTime?
  deposit_order_id         String?  @map("deposit_order_id")
  before_image_id          String?  @map("before_image_id")
  after_image_id           String?  @map("after_image_id")
  public_use_consent       Boolean  @default(false)
  is_published_to_gallery  Boolean  @default(false)
  status_token             String   @unique
  internal_notes           String?  @db.Text

  customer            Customer? @relation(fields: [customer_id], references: [id])
  service_tier        RestorationServiceTier? @relation(fields: [service_tier_id], references: [id])
  intake_images       RestorationIntakeImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restoration_jobs")
}

model RestorationIntakeImage {
  id        String   @id @default(cuid())
  job_id    String   @map("job_id")
  media_asset_id String @map("media_asset_id")

  job       RestorationJob @relation(fields: [job_id], references: [id])
  media_asset MediaAsset @relation(fields: [media_asset_id], references: [id])

  @@map("restoration_intake_images")
}

model RestorationServiceTier {
  id    String @id @default(cuid())
  name  String
  description String? @db.Text
  starting_price Int
  typical_turnaround_days Int
  is_active Boolean @default(true)

  jobs RestorationJob[]

  @@map("restoration_service_tiers")
}

model MediaAsset {
  id          String   @id @default(cuid())
  folder_id   String?  @map("folder_id")
  filename    String
  url         String
  thumbnail_url String?
  mime_type   String
  file_size   Int
  width       Int?
  height      Int?
  alt_text    String?
  uploaded_by_admin_id String? @map("uploaded_by_admin_id")

  folder          MediaFolder? @relation(fields: [folder_id], references: [id])
  product_images  ProductImage[]
  review_images   ReviewImage[]
  restoration_intake_images RestorationIntakeImage[]

  createdAt DateTime @default(now())

  @@map("media_assets")
}

model MediaFolder {
  id           String   @id @default(cuid())
  name         String
  parent_folder_id String? @map("parent_folder_id")

  assets MediaAsset[]

  @@map("media_folders")
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  status      String   @default("draft")
  seo_title   String?
  seo_description String? @map("seo_description")
  seo_image_id String? @map("seo_image_id")
  published_at DateTime?

  blocks PageBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

model PageBlock {
  id          String   @id @default(cuid())
  page_id     String   @map("page_id")
  block_type  String
  content     Json
  sort_order  Int @default(0)

  page Page @relation(fields: [page_id], references: [id])

  @@map("page_blocks")
}

model HomepageSection {
  id         String   @id @default(cuid())
  section_type String
  config     Json
  sort_order Int @default(0)
  is_active  Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("homepage_sections")
}

model NavigationItem {
  id          String   @id @default(cuid())
  menu        String
  label       String
  url         String
  sort_order  Int @default(0)
  parent_id   String?  @map("parent_id")

  @@map("navigation_items")
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  category    String
  sort_order  Int @default(0)
  is_active   Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("faqs")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  body        String   @db.Text
  cover_image_id String? @map("cover_image_id")
  author      String
  status      String   @default("draft")
  published_at DateTime?
  seo_title   String?
  seo_description String? @map("seo_description")
  seo_image_id String? @map("seo_image_id")
  linked_product_ids Int[] @map("linked_product_ids")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model Setting {
  key       String   @id
  value     Json
  value_type String
  validation_rule String?
  updated_by  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model NotificationTemplate {
  event_key       String   @id
  subject         String
  body_html       String   @db.Text
  body_text       String?  @db.Text
  is_enabled      Boolean  @default(true)
  available_merge_tags String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model FeatureFlag {
  key         String   @id
  is_enabled  Boolean  @default(false)
  description String?

  createdAt DateTime @default(now())

  @@map("feature_flags")
}

model Redirect {
  from_path String @id
  to_path   String
  status_code Int @default(301)

  createdAt DateTime @default(now())

  @@map("redirects")
}

model AdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  password_hash String
  name        String
  role        String   @default("admin")
  is_active   Boolean  @default(true)
  last_login_at DateTime?

  createdAt DateTime @default(now())

  @@map("admin_users")
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_id    String?
  actor_type  String
  action      String
  entity_type String
  entity_id   String?
  before_value Json?
  after_value  Json?
  ip_address   String?
  created_at   DateTime @default(now())

  @@map("audit_logs")
}

model ConsentRecord {
  id                  String   @id @default(cuid())
  customer_id         String?  @map("customer_id")
  email               String?
  phone               String?
  consent_type        String
  consent_text_shown  String   @db.Text
  granted             Boolean
  ip_address          String?
  user_agent          String?
  created_at          DateTime @default(now())

  customer Customer? @relation(fields: [customer_id], references: [id])

  @@map("consent_records")
}

model SearchQueryLog {
  id          String   @id @default(cuid())
  query       String
  result_count Int
  customer_id String?  @map("customer_id")
  created_at  DateTime @default(now())

  customer Customer? @relation(fields: [customer_id], references: [id])

  @@map("search_query_logs")
}

model AbandonedCheckout {
  id                   String   @id @default(cuid())
  customer_id          String?  @map("customer_id")
  email                String?
  phone                String?
  cart_contents        Json
  subtotal             Int
  recovered_order_id   String?  @map("recovered_order_id")
  created_at           DateTime @default(now())

  customer Customer? @relation(fields: [customer_id], references: [id])

  @@map("abandoned_checkouts")
}

model WaitlistSignup {
  id                   String   @id @default(cuid())
  collection_name      String
  customer_id        String?  @map("customer_id")
  deposit_paid       Boolean  @default(false)
  deposit_order_id   String?  @map("deposit_order_id")

  customer Customer? @relation(fields: [customer_id], references: [id])

  @@map("waitlist_signups")
}

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String
  states      String[] @default([])
  fee         Int
  estimated_days String

  createdAt DateTime @default(now())

  @@map("delivery_zones")
}